# MuseFlow platform example. Copy to .env; never commit real credentials.
# The checked-in defaults are for a localhost-only, non-billing development stack.

# -----------------------------------------------------------------------------
# Application and deployment
# -----------------------------------------------------------------------------
PLATFORM_MODE=true
NODE_ENV=development
APP_VERSION=development
PUBLIC_URL=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
MUSEFLOW_PORT=8787
MUSEFLOW_IMAGE=museflow-ai-music:local
DATA_DIR=./data

# -----------------------------------------------------------------------------
# PostgreSQL 16
# docker-compose.yml rewrites DATABASE_URL to the internal `postgres` hostname.
# -----------------------------------------------------------------------------
POSTGRES_USER=museflow
POSTGRES_PASSWORD=museflow-local-change-me
POSTGRES_DB=museflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://museflow:museflow-local-change-me@127.0.0.1:5432/museflow
DATABASE_POOL_SIZE=12
# Optional Compose-only override for an external/managed database.
MUSEFLOW_DATABASE_URL=

# -----------------------------------------------------------------------------
# Valkey / BullMQ
# docker-compose.yml rewrites REDIS_URL to the internal `valkey` hostname.
# -----------------------------------------------------------------------------
VALKEY_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# Optional Compose-only override for an external/managed Valkey/Redis.
MUSEFLOW_REDIS_URL=
REDIS_KEY_PREFIX=museflow:local
QUEUE_DRIVER=bullmq
MUSIC_POLL_INTERVAL_MS=4000
WORKER_POLL_LEASE_MS=900000
PROVIDER_RESULT_GRACE_MS=300000
WORKER_CONCURRENCY=4
MAX_CONCURRENT_GENERATIONS_PER_USER=2
MAX_CONCURRENT_AI_RUNS_PER_USER=4

# -----------------------------------------------------------------------------
# Private S3-compatible object storage (RustFS locally)
# docker-compose.yml rewrites S3_ENDPOINT to http://minio:9000.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=museflow-minio
MINIO_ROOT_PASSWORD=museflow-minio-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
# Public HTTPS origin used only for Provider-facing signed URLs. Keep blank for
# local RustFS; upload/upload_extend then remain disabled outside fake preview.
S3_PRESIGN_ENDPOINT=
PROVIDER_UPLOAD_URLS_REACHABLE=false
S3_REGION=us-east-1
S3_BUCKET=museflow
S3_ACCESS_KEY_ID=museflow-minio
S3_SECRET_ACCESS_KEY=museflow-minio-change-me
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_LOCAL_DIR=./data/objects
# Optional Compose-only cloud-storage overrides. Blank means local RustFS.
MUSEFLOW_S3_ENDPOINT=
MUSEFLOW_S3_PRESIGN_ENDPOINT=
MUSEFLOW_S3_ACCESS_KEY_ID=
MUSEFLOW_S3_SECRET_ACCESS_KEY=

# Only local fake-provider tests should allow private asset hosts. The platform
# ignores this opt-in in NODE_ENV=production. Use a strict CDN allowlist there.
ALLOW_PRIVATE_ASSET_URLS=true
ASSET_HOST_ALLOWLIST=

# -----------------------------------------------------------------------------
# Authentication and ModelCross integration
# Local development uses an explicit demo identity. Production forbids it.
# -----------------------------------------------------------------------------
AUTH_MODE=development
MUSEFLOW_SESSION_SECRET=museflow-development-session-secret-change-me
SESSION_COOKIE_NAME=museflow_session
SESSION_MAX_AGE_SECONDS=2592000

# Use the same canonical hostname in the browser, Discovery, and JWT `iss`.
# The Compose stack maps this hostname to the host gateway for server calls.
# Production must use one canonical public HTTPS issuer.
MODELCROSS_OIDC_ISSUER=http://modelcross.localhost:3000
MODELCROSS_OIDC_CLIENT_ID=museflow
MODELCROSS_OIDC_CLIENT_SECRET=
MODELCROSS_OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
MODELCROSS_OIDC_SCOPES=openid profile email modelcross.work modelcross.work.billing
MODELCROSS_BASE_URL=http://modelcross.localhost:3000
# Browser-facing links must use a hostname reachable by the user's browser.
MODELCROSS_ACCOUNT_URL=http://modelcross.localhost:3000/profile
MODELCROSS_WALLET_URL=http://modelcross.localhost:3000/wallet
MODELCROSS_ORDERS_URL=http://modelcross.localhost:3000/usage-logs
MODELCROSS_TASK_TOKEN_SECRET=
# Deployment-only ModelCross API token used exclusively for /v1/responses.
# It is separate from the user-bound task token used for Work Billing.
MODELCROSS_AI_RELAY_TOKEN=
MODELCROSS_LYRICS_MODEL=mc-music-lyrics
MODELCROSS_FAST_MODEL=mc-music-fast
MODELCROSS_AI_MODELS=mc-music-lyrics,mc-music-fast

# Safety gates: never change these merely to make a smoke test pass. Enable
# billing only after idempotency/recovery/refund tests pass against staging.
BILLING_LIVE_ENABLED=false
AI_LIVE_ENABLED=false
# Explicit local-only direct AI mode. This calls ModelCross from the server
# without Work Billing and is rejected outside AUTH_MODE=development.
AI_LOCAL_LIVE_ENABLED=false

# -----------------------------------------------------------------------------
# MXAPI / Suno direct client (Fake Provider tests only; never use VITE_*).
# Real billing always routes through ModelCross, where the permanent MXAPI Key
# is stored in a Suno Channel or read-only Secret File. Keep this key empty in
# the normal MuseFlow stack.
# -----------------------------------------------------------------------------
SUNO_API_BASE_URL=https://open.mxapi.org
SUNO_API_KEY=
SUNO_POLL_INTERVAL_MS=5000
SUNO_REQUEST_TIMEOUT_MS=30000

# MV Studio. Off by default; local live generation bills the provider API account.
MV_LOCAL_LIVE_ENABLED=false
MV_API_BASE_URL=https://open.mxapi.org
MV_API_KEY_FILE=
# Optional Suno server-side key file for the existing explicitly enabled local direct mode.
SUNO_API_KEY_FILE=
# Native FFmpeg is installed in the application container. Host development can use OrbStack.
MV_FFMPEG_DOCKER_IMAGE=
MV_WORK_DIR=
MV_FONT_PATH=
MV_FONT_FAMILY=Noto Sans CJK SC

# Optional local read-only signed-media bridge. Never forwards the application API.
ASSET_RELAY_ENABLED=false
ASSET_RELAY_PORT=8790
ASSET_RELAY_AUTO_TUNNEL=false
ASSET_RELAY_PUBLIC_URL=
ASSET_RELAY_PUBLIC_URL_FILE=
CLOUDFLARED_PATH=.tools/cloudflared
